# Example environment variables for this project.
# Copy this file to .env.local and fill in real values. Do NOT commit secrets.

# Google Generative AI API key (Gemini). Get this from the Google Cloud Console
# under the Generative AI / API Keys section for your project.
GOOGLE_GENERATIVE_AI_API_KEY=your-google-generative-ai-api-key-here

# Firebase project ID. Find this in the Firebase Console → Project settings.
FIREBASE_PROJECT_ID=your-firebase-project-id

# Firebase service account client email. From the service account JSON
# you create in Firebase Console → Project settings → Service accounts.
FIREBASE_CLIENT_EMAIL=your-service-account@example.iam.gserviceaccount.com

# Firebase service account private key. From the service account JSON.
# When adding to an env file, replace real newlines with \n (keep the key on one line).
# Example placeholder shown with escaped newlines.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Optional: Override chat rate limit max requests per IP window (production default is 10).
# Set a small value for testing, or leave unset to use the default in code.
RATE_LIMIT_MAX=10

# Optional: Rate limit window in milliseconds (default is 600000 = 10 minutes).
# You can adjust this if you want a shorter or longer window for the RATE_LIMIT_MAX above.
RATE_LIMIT_WINDOW_MS=600000
